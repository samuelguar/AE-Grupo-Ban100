                <mxCell id="lt1" value="&lt;b&gt;T1 · SPOOFING&lt;/b&gt; &lt;span style=&quot;color:#dc2626;&quot;&gt;(Crítico)&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;Elemento: P1 — Canal móvil / API Gateway&lt;br/&gt;Suplantación de pensionado vía deepfake o foto animada en la prueba de vida.&lt;br/&gt;&lt;b&gt;Mitigación:&lt;/b&gt; biometría pasiva iBeta N2 + FIDO2.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="leg" vertex="1">
                    <mxGeometry x="15" y="45" width="318" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="lt2" value="&lt;b&gt;T2 · TAMPERING&lt;/b&gt; &lt;span style=&quot;color:#dc2626;&quot;&gt;(Crítico)&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;Elemento: P3 — Módulo Bre-B / ISO 20022&lt;br/&gt;Alteración del pacs.008 en tránsito para desviar el monto a una cuenta mula.&lt;br/&gt;&lt;b&gt;Mitigación:&lt;/b&gt; firma XML-DSig/JWS + mTLS extremo a extremo.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="leg" vertex="1">
                    <mxGeometry x="348" y="45" width="318" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="lt4" value="&lt;b&gt;T4 · INFORMATION DISCLOSURE&lt;/b&gt; &lt;span style=&quot;color:#dc2626;&quot;&gt;(Crítico)&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;Elemento: D1 — BD Transaccional / MDM&lt;br/&gt;Extracción masiva de mesadas y cuentas vía IDOR o inyección SQL.&lt;br/&gt;&lt;b&gt;Mitigación:&lt;/b&gt; TDE AES-256, masking dinámico y RBAC estricto.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="leg" vertex="1">
