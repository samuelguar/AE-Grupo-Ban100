                <mxCell id="lt5" value="&lt;b&gt;T5 · DENIAL OF SERVICE&lt;/b&gt; &lt;span style=&quot;color:#ea580c;&quot;&gt;(Alto)&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;Elemento: P1 — API Gateway institucional&lt;br/&gt;HTTP Flood en días pico de pago de mesadas; incumple el SLA de 99.99%.&lt;br/&gt;&lt;b&gt;Mitigación:&lt;/b&gt; WAF con DDoS en CDN, rate limiting y HPA.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="leg" vertex="1">
