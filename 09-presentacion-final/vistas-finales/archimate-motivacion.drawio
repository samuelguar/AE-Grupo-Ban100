  <diagram id="motivacion-final" name="Vista ArchiMate Motivacion Ban100 (Taller 9)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Vista ArchiMate 3.2 — Capa de Motivación (Ban100 S.A.) · Objetivos → Principios → Requerimientos&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;labelBackgroundColor=none;fontSize=17;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1440" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="band_mot" value="MOTIVACIÓN" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#F2F2FF;strokeColor=#6666CC;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#3A3A99;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1440" height="810" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="«Stakeholder»&lt;br&gt;&lt;b&gt;Presidencia Ejecutiva y Junta Directiva Ban100&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=11;" vertex="1" parent="band_mot">
          <mxGeometry x="30" y="50" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="«Stakeholder»&lt;br&gt;&lt;b&gt;Superintendencia Financiera (SFC), SIC e inversionistas ESG&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=11;" vertex="1" parent="band_mot">
          <mxGeometry x="360" y="50" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="«Stakeholder»&lt;br&gt;&lt;b&gt;Pensionados y empleados públicos en 1.000+ municipios&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=11;" vertex="1" parent="band_mot">
          <mxGeometry x="690" y="50" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="drv" value="«Driver»&lt;br&gt;&lt;b&gt;Asimetría tecnológica de 850–880 pagadurías de Grupos MRAE 3 a 5 (40 a 47 meses de rezago)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=11;" vertex="1" parent="band_mot">
          <mxGeometry x="1020" y="50" width="380" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="g1" value="«Goal»&lt;br&gt;&lt;b&gt;O1 · Cobertura territorial&lt;/b&gt;&lt;br&gt;Inclusión financiera en 1.000+ municipios (90 % del país) con 10 oficinas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=11;" vertex="1" parent="band_mot">
          <mxGeometry x="30" y="190" width="320" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="g2" value="«Goal»&lt;br&gt;&lt;b&gt;O2 · Calidad de cartera&lt;/b&gt;&lt;br&gt;Mantener la calificación AAA ESG en titularizaciones de hasta COP $1 billón" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=11;" vertex="1" parent="band_mot">
          <mxGeometry x="380" y="190" width="320" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="g3" value="«Goal»&lt;br&gt;&lt;b&gt;O3 · Velocidad competitiva&lt;/b&gt;&lt;br&gt;Originar libranza en menos de 15 minutos (hoy 3 a 5 días)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=11;" vertex="1" parent="band_mot">
          <mxGeometry x="730" y="190" width="320" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="g4" value="«Goal»&lt;br&gt;&lt;b&gt;O4 · Cumplimiento normativo&lt;/b&gt;&lt;br&gt;SFC (CE 008/2023), SIC (Ley 1581) y homologación MRAE v3.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCFF;strokeColor=#6666CC;fontSize=11;" vertex="1" parent="band_mot">
          <mxGeometry x="1080" y="190" width="320" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="p1" value="«Principle»&lt;br&gt;&lt;b&gt;P1 · Desacople asimétrico de la contraparte&lt;/b&gt;&lt;br&gt;&lt;i&gt;La velocidad de Ban100 no depende de la madurez digital de un tercero&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3B3FF;strokeColor=#4B4BA8;fontSize=10;" vertex="1" parent="band_mot">
          <mxGeometry x="30" y="345" width="255" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="«Principle»&lt;br&gt;&lt;b&gt;P2 · El Core no se cambia, se desacopla&lt;/b&gt;&lt;br&gt;&lt;i&gt;Se elimina la dependencia síncrona, no el sistema heredado&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3B3FF;strokeColor=#4B4BA8;fontSize=10;" vertex="1" parent="band_mot">
          <mxGeometry x="310" y="345" width="255" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="«Principle»&lt;br&gt;&lt;b&gt;P3 · Dato personal mínimo y supervisado&lt;/b&gt;&lt;br&gt;&lt;i&gt;Ningún componente accede a más PII de la que su tarea exige&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3B3FF;strokeColor=#4B4BA8;fontSize=10;" vertex="1" parent="band_mot">
          <mxGeometry x="590" y="345" width="255" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="«Principle»&lt;br&gt;&lt;b&gt;P4 · Cumplir antes de escalar&lt;/b&gt;&lt;br&gt;&lt;i&gt;Una brecha normativa abierta bloquea el despliegue de su fase&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3B3FF;strokeColor=#4B4BA8;fontSize=10;" vertex="1" parent="band_mot">
          <mxGeometry x="870" y="345" width="255" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p5" value="«Principle»&lt;br&gt;&lt;b&gt;P5 · Trazabilidad como activo de cartera&lt;/b&gt;&lt;br&gt;&lt;i&gt;Toda operación debe ser reconstruible de punta a punta&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3B3FF;strokeColor=#4B4BA8;fontSize=10;" vertex="1" parent="band_mot">
          <mxGeometry x="1150" y="345" width="250" height="115" as="geometry"/>
        </mxCell>

        <mxCell id="r1" value="«Requirement»&lt;br&gt;&lt;b&gt;Adaptador B2G de Dos Velocidades&lt;/b&gt;&lt;br&gt;API/X-Road para G1–G2 · RPA/ETL y Portal de Autogestión para G3–G5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1E1FF;strokeColor=#6666CC;fontSize=10;" vertex="1" parent="band_mot">
          <mxGeometry x="30" y="520" width="215" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="«Requirement»&lt;br&gt;&lt;b&gt;Bus de Eventos CDC (&amp;lt; 500 ms)&lt;/b&gt;&lt;br&gt;Con Circuit Breaker y BCP/DRP automatizado hacia el Core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1E1FF;strokeColor=#6666CC;fontSize=10;" vertex="1" parent="band_mot">
          <mxGeometry x="265" y="520" width="215" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="r3" value="«Requirement»&lt;br&gt;&lt;b&gt;Guardrails DLP y Human-in-the-Loop&lt;/b&gt;&lt;br&gt;Sobre el Orquestador Agéntico Ban-I Bot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1E1FF;strokeColor=#6666CC;fontSize=10;" vertex="1" parent="band_mot">
          <mxGeometry x="500" y="520" width="215" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="r4" value="«Requirement»&lt;br&gt;&lt;b&gt;Revocatoria y supresión automatizada&lt;/b&gt;&lt;br&gt;Ley 1581 art. 8, con propagación a Cliente 360 y proveedores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1E1FF;strokeColor=#6666CC;fontSize=10;" vertex="1" parent="band_mot">
          <mxGeometry x="735" y="520" width="215" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="r5" value="«Requirement»&lt;br&gt;&lt;b&gt;Borde Dual-Stack IPv6/IPv4&lt;/b&gt;&lt;br&gt;Y API Gateway Activo-Activo (MGGTI.LI.ST.14)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1E1FF;strokeColor=#6666CC;fontSize=10;" vertex="1" parent="band_mot">
          <mxGeometry x="970" y="520" width="215" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="r6" value="«Requirement»&lt;br&gt;&lt;b&gt;Trazabilidad por solicitud y conciliación&lt;/b&gt;&lt;br&gt;Cliente 360 (MDM) y repositorio de AE con métricas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1E1FF;strokeColor=#6666CC;fontSize=10;" vertex="1" parent="band_mot">
          <mxGeometry x="1205" y="520" width="195" height="115" as="geometry"/>
        </mxCell>

        <mxCell id="c1" value="«Constraint»&lt;br&gt;&lt;b&gt;No se reemplaza el Core Bancario transaccional&lt;/b&gt; (fuera del alcance declarado en el Taller 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;dashed=1;" vertex="1" parent="band_mot">
          <mxGeometry x="265" y="690" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="«Constraint»&lt;br&gt;&lt;b&gt;Ban100 no es sujeto obligado del Decreto 767 de 2022&lt;/b&gt;: el MRAE se usa como marco homologable, no como obligación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;dashed=1;" vertex="1" parent="band_mot">
          <mxGeometry x="870" y="690" width="320" height="80" as="geometry"/>
        </mxCell>

