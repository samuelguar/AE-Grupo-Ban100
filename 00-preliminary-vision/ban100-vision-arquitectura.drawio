                <mxCell id="t_lbl" value="&lt;b&gt;DIMENSIONES DE GOBIERNO, GESTIÓN Y APROPIACIÓN (MARCO MinTIC MRAE v3.0)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1e293b;" parent="1" vertex="1">
