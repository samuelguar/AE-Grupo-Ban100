                <mxCell id="ext_truora" value="&lt;b&gt;Aliado: Truora S.A.S.&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(107, 114, 128);&quot;&gt;[Sistema Externo]&lt;/font&gt;&lt;br&gt;Biometría facial, liveness (FIDO), OCR de cédulas, firma electrónica Ley 527 y estampado cronológico." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=12;spacing=4;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="150" width="280" height="100" as="geometry"/>
