                <mxCell id="actor_pen" value="&lt;b&gt;Pensionados y Empleados&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(107, 114, 128);&quot;&gt;[Persona]&lt;/font&gt;&lt;br&gt;Solicitan créditos de libranza, consultan saldos y realizan transferencias Bre-B." style="shape=mxgraph.flowchart.user_input;whiteSpace=wrap;fillColor=#e0e7ff;strokeColor=#4338ca;fontSize=12;html=1;spacing=4;" parent="1" vertex="1">
