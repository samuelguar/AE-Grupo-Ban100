                <mxCell id="c1_hdrtxt" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255); font-size: 18px;&quot;&gt;C4 NIVEL 1 — VISTA DE CONTEXTO DEL SISTEMA: PLATAFORMA DIGITAL BAN100&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(203, 213, 225); font-size: 14px;&quot;&gt;Actores, Sistema en Alcance y Sistemas Externos — Modelo C4 (Simon Brown)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;" parent="1" vertex="1">
